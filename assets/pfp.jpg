  .profile-header-wrap{flex-direction:column!important;padding:20px 16px!important}
  .site-footer{padding:16px!important;flex-direction:column!important;text-align:center!important}
  .footer-links{justify-content:center!important;gap:10px!important}
}
</style>
<script>
function setTheme(t){
  if(t==='midnight'){document.documentElement.removeAttribute('data-theme')}
  else{document.documentElement.setAttribute('data-theme',t)}
  localStorage.setItem('imgbs_theme',t);
  // Update active dots
  document.querySelectorAll('.theme-dot').forEach(function(d){d.classList.toggle('active',d.getAttribute('data-t')===t)});
}
// Mark active theme on load
(function(){var t=localStorage.getItem('imgbs_theme')||'midnight';document.querySelectorAll('.theme-dot').forEach(function(d){d.classList.toggle('active',d.getAttribute('data-t')===t)})})();
</script>
<script>
(function(){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap';document.head.appendChild(l)})();
</script>
<div id="regBanner" style="display:none;position:fixed;bottom:0;left:0;right:0;background:#0e0e12;border-top:1px solid #2a2a2e;padding:12px 20px;z-index:9999;font-family:var(--font)">
  <div style="max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:10px;min-width:0">
      <span style="color:#39ff14;font-size:16px;flex-shrink:0">&#9889;</span>
      <span style="color:#b0b0b8;font-size:13px">Create a free account to upload, organize, and share your images</span>
    </div>
    <div style="display:flex;gap:8px;flex-shrink:0">
      <a href="https://imgbs.com/register.php" style="padding:7px 16px;background:#39ff14;color:#000;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap">Register</a>
      <button onclick="document.getElementById('regBanner').style.display='none';localStorage.setItem('imgbs_dismiss_reg','1')" style="padding:7px 12px;color:#5a5a66;font-size:12px;cursor:pointer;background:none;border:none;font-family:var(--font)">Dismiss</button>
    </div>
  </div>
</div>
<script>
(function(){
  if(localStorage.getItem('imgbs_dismiss_reg'))return;
  setTimeout(function(){document.getElementById('regBanner').style.display='block'},30000);
})();
</script>
</body>
</html>
