<script>
function copyEmbed(b){var i=b.parentElement.querySelector('.embed-input');i.select();document.execCommand('copy');b.textContent='Copied!';setTimeout(function(){b.textContent='Copy'},1500)}
function toggleFav(id){var x=new XMLHttpRequest();x.open('POST','https://imgbs.com/api/favorite.php',true);x.setRequestHeader('Content-Type','application/x-www-form-urlencoded');x.onload=function(){try{var d=JSON.parse(x.responseText);var b=document.getElementById('favBtn'),s=b.querySelector('svg');document.getElementById('favCount').textContent=d.count||'';if(d.favorited){s.setAttribute('fill','#39ff14');b.style.color='#39ff14'}else{s.setAttribute('fill','none');b.style.color=''}}catch(e){}};x.send('image_id='+id)}

/* Lightbox */
function openLightbox(){
  var lb=document.getElementById('lightbox');
  document.getElementById('lightboxImg').src='https://imgbs.com/uploads/rann-a41c9468.png'; // Always show original in lightbox
  document.getElementById('lightboxDownload').href='https://imgbs.com/download.php?id=7587';
  lb.style.display='flex';
  document.body.style.overflow='hidden';
}
function closeLightbox(){
  document.getElementById('lightbox').style.display='none';
  document.body.style.overflow='';
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeLightbox()});
</script>
